rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Attendance records — one doc per student/guest, keyed by ID
    match /att/{id} {
      allow read, write: if true;
    }
    match /guests/{id} {
      allow read, write: if true;
    }

    // App config: Login IDs + roles, and gift-group settings
    match /cfg/{doc} {
      allow read, write: if true;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
